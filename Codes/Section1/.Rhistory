n <- 50
M <- 100
mu0 <- 1
power0 <- function(mu) {
I=0
for (i in 1:M){
x=rnorm(n,mu,1)
m=median(x)
s=sqrt(mean((x-m)^2))
if(m>mu0+s/sqrt(n)*1.64) I=I+1
}
I/M
}
power0 <- Vectorize(power0)
power0(mu0)
power0(mu0)
power0(mu0)

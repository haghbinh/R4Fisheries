# sample data for one fish specimen
total_length_cm <- 35.2   # total length in cm
weight_g <- 680           # weight in grams
species <- "Cyprinus carpio"
# Fulton's condition factor
K <- (weight_g * 100) / (total_length_cm^3)
cat("Condition Factor (K):", round(K, 3), "\n")
# length-weight relationship parameters (example values from literature)
a <- 0.0141
b <- 3.02
# predicted weight from length
W_predicted <- a * (total_length_cm^b)
cat("Predicted weight (g):", round(W_predicted, 2), "\n")
# relative weight (Wr): ratio of observed to standard weight
# (requires species-specific Ws equation; simplified example below)
W_standard <- a * (total_length_cm^b)
Wr <- (weight_g / W_standard) * 100
cat("Relative Weight (Wr):", round(Wr, 1), "\n")
# data type check
cat("Type of total_length_cm:", class(total_length_cm), "\n")
cat("Type of species:", class(species), "\n")

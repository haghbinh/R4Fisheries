mytest <- function(x,p0){
n <- length(x)
Z <- function(x){
xbar <- mean(x)
z <- (xbar-p0)/sqrt(xbar*(1-xbar)/n)
return(z)
}
z0 <- mean(x)
M <- 100000
zi <- c()
# for(i in 1:M){
#   xi <- rbinom(n,1,p0)
#   zi[i] <- Z(xi)
# }
X <- matrix(rbinom(n*M,1,p0),nrow = n, ncol=M)
zi <- apply(X,2,FUN = mean)
q <- quantile(zi,probs = 0.95)
if (z0 > q) print("H0 Riject") else print("H0 Accept")
pvalue <- sum(zi>z0)/M
print(paste("P-value=",pvalue))
}
mytest(x,0.5)
mytest(x,0.5)
mytest(x,0.5)
